    affiliation: "Ecluna team, NASA Space Apps Jakarta 2026"
  - family-names: "Nadhif"
    given-names: "Alezuna"
    affiliation: "Ecluna team, NASA Space Apps Jakarta 2026"
  - family-names: "Hafizul"
    given-names: "Rio"
    affiliation: "Ecluna team, NASA Space Apps Jakarta 2026"
keywords:
  - astronomy
  - SPHEREx
  - moving objects
  - detection limit
  - NASA Space Apps
references:
